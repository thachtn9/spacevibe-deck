{
  "manifest_version": 3,
  "name": "Deck Review",
  "version": "1.1.0",
  "description": "Select elements, annotate your web app and send requests to the active Deck agent.",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"],
  "host_permissions": ["http://127.0.0.1:43129/*"],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Deck Review (Alt+X to inspect)"
  },
  "commands": {
    "toggle-review": {
      "suggested_key": {
        "default": "Alt+X"
      },
      "description": "Toggle in-page Deck Review toolbar"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Toggle Deck Review toolbar"
    }
  },
  "key": ""
}
